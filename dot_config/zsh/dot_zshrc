#safe_source "$HOME/.profile" # Load the default .profile

#zprof

unset_sshkey_override_if_possible()

bindkey -M viins '^U' forward_kill_line

[[ -f /opt/homebrew/opt/antidote/share/antidote/antidote.zsh ]] && source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
zstyle ':antidote:bundle' file $ZDOTDIR/antidote.conf
zstyle ':antidote:static' file $ZDOTDIR/antidote.zsh

zstyle ':zephyr:plugin:confd' 'immediate' 'yes'


antidote load
